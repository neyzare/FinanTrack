generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @unique @default(cuid())
  email        String        @unique
  password     String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  stocks       Stock[]
  sandboxState SandboxState?
}

model Stock {
  id        Int      @id @default(autoincrement())
  ticker    String
  name      String?
  quantity  Int      @default(0)
  buyPrice  Float
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots StockSnapshot[]

  @@unique([userId, ticker])
  @@index([userId])
  @@index([ticker])
}

model StockSnapshot {
  id      Int    @id @default(autoincrement())
  stockId Int
  ticker  String
  userId  String

  price      Float
  quantity   Int
  totalValue Float

  snapshotDate DateTime @default(now())
  createdAt    DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, snapshotDate])
  @@index([userId, snapshotDate])
  @@index([ticker, snapshotDate])
  @@index([snapshotDate])
}

model CandleStock {
  id     Int      @id @unique @default(autoincrement())
  name   String
  ticker String
  open   Float
  high   Float
  low    Float
  close  Float
  Volume Int
  date   DateTime
}

model CachedQuote {
  ticker    String   @id
  price     Float
  variation Float?
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model SandboxStock {
  id      Int    @id @default(autoincrement())
  name    String
  secteur String
  price   Float
}

model SandboxState {
  userId     String   @id
  liquidite  Float    @default(10000)
  positions  Json     @default("[]")
  historique Json     @default("[]")
  candles    Json     @default("{}")
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
