@startuml
!theme plain

package "Frontend (Next.js)" {
  [Pages]
  [Components]
  [Forms]
}

package "API Layer" {
  [Server Actions]
  [API Routes]
}

package "Business Logic" {
  [Auth Service]
  [Stock Service]
  [Calculator Service]
  [Sandbox Service]
  [Password Reset Service]
  [Quote Cache]
  [Finnhub Client]
  [Resend Client]
}

package "Data Layer" {
  [Prisma ORM]
  database PostgreSQL
}

package "External Services" {
  [Finnhub API]
  [Resend API]
}

[Pages] --> [Forms]
[Pages] --> [Components]
[Forms] --> [Server Actions]
[Server Actions] --> [Auth Service]
[Server Actions] --> [Stock Service]
[Server Actions] --> [Calculator Service]
[Server Actions] --> [Sandbox Service]
[Server Actions] --> [Password Reset Service]
[Auth Service] --> [Prisma ORM]
[Stock Service] --> [Prisma ORM]
[Stock Service] --> [Quote Cache]
[Sandbox Service] --> [Prisma ORM]
[Password Reset Service] --> [Prisma ORM]
[Password Reset Service] --> [Resend Client]
[Quote Cache] --> [Prisma ORM]
[Quote Cache] --> [Finnhub Client]
[Finnhub Client] --> [Finnhub API]
[Resend Client] --> [Resend API]
[Prisma ORM] --> PostgreSQL
[API Routes] --> [Finnhub Client]

note bottom of [Quote Cache]
  Table CachedQuote :
  cache des cours 5 min
  pour limiter les appels
  à Finnhub
end note

@enduml
