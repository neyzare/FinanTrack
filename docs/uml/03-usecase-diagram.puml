@startuml
!theme plain

left to right direction

actor Utilisateur as user
actor "Finnhub API" as api
actor "Resend (email)" as resend

rectangle "FinanTrack Application" {
  usecase "S'inscrire" as UC1
  usecase "Se connecter" as UC2
  usecase "Se déconnecter" as UC3
  usecase "Consulter le dashboard" as UC4
  usecase "Ajouter une action" as UC5
  usecase "Modifier la quantité" as UC6
  usecase "Supprimer une action" as UC7
  usecase "Consulter le portefeuille" as UC8
  usecase "Obtenir prix en temps réel" as UC9
  usecase "Calculer intérêts composés" as UC10
  usecase "Gérer les paramètres" as UC11
  usecase "Réinitialiser le mot de passe" as UC12
  usecase "Envoyer l'email de réinitialisation" as UC13
  usecase "Trader en sandbox (achat/vente)" as UC14
  usecase "Consulter wallet et historique sandbox" as UC15
  usecase "Réinitialiser la sandbox" as UC16
  usecase "Consulter les pages légales" as UC17
}

user --> UC1
user --> UC2
user --> UC3
user --> UC4
user --> UC5
user --> UC6
user --> UC7
user --> UC8
user --> UC10
user --> UC11
user --> UC12
user --> UC14
user --> UC15
user --> UC16
user --> UC17

UC5 ..> UC9 : <<include>>
UC8 ..> UC9 : <<include>>
UC9 --> api

UC12 ..> UC13 : <<include>>
UC13 --> resend

note right of UC9
  Communication avec
  l'API externe Finnhub
  pour obtenir les cours
  boursiers en temps réel
  (mise en cache 5 min
  via la table CachedQuote)
end note

note right of UC14
  Simulateur de trading avec
  capital virtuel de 10 000 €,
  actions fictives (SandboxStock)
  et état persisté en base
  (SandboxState)
end note

note right of UC17
  CGU, mentions légales et
  politique de confidentialité
  accessibles depuis le footer
end note

@enduml
